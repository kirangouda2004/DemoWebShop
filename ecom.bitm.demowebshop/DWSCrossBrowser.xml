<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="DWSCrossBrowserSuite">

    <test name="ChromeTests">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="demowebshop.login.signup_logintestcase"/>
            <class name="demowebshop.homepage.homepagetestcase"/>
            <class name="demowebshop.cart.carttestcase"/>
            <class name="demowebshop.checkout.checkouttestcase"/>
        </classes>
    </test>

    <test name="FirefoxTests">
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="demowebshop.login.signup_logintestcase"/>
            <class name="demowebshop.homepage.homepagetestcase"/>
            <class name="demowebshop.cart.carttestcase"/>
            <class name="demowebshop.checkout.checkouttestcase"/>
        </classes>
    </test>

    <test name="EdgeTests">
        <parameter name="browser" value="edge"/>
        <classes>
            <class name="demowebshop.login.signup_logintestcase"/>
            <class name="demowebshop.homepage.homepagetestcase"/>
            <class name="demowebshop.cart.carttestcase"/>
            <class name="demowebshop.checkout.checkouttestcase"/>
        </classes>
    </test>

</suite>
